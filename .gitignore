scripts/dev/scratch/
# - 150MB+ derlenmis ajan kurulum dosyasi (GitHub'in 100MB dosya sinirini
#   asiyor, ayrica repoyu gereksiz sisiriyor - ayri bir yerden dagitilmali)
scripts/*.exe
scripts/dev/_tmpverifysql.cjs

# kpsv2/ - KPS/NVI relay servisi: tamamen AYRI bir .NET (ASP.NET) uygulamasi,
# bu depodaki Next.js/Node koduyla ilgisiz. Kendi (bos/kirik) .git klasoru
# bile var - ayri bir repo olmasi gerekiyormus gibi duruyor. Derlenmis
# DLL/EXE/obj/bin/packages/.vs klasorleriyle birlikte YUZLERCE MB
# siklet getirirdi, bu yuzden TAMAMEN haric tutuldu. Ayri versiyonlamak
# istenirse kendi bagimsiz deposu kurulmali.
kpsv2/
