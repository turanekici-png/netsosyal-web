# Database Configuration
# PostgreSQL bağlantı stringi
# Format: postgresql://kullanıcı:şifre@host:port/veritabani_adı
DATABASE_URL="postgresql://postgres:password@localhost:5432/sosyal_yardim"
AUTH_SECRET="en-az-32-bayt-rastgele-bir-deger"
NVI_BRIDGE_TOKEN="nvi-kopru-servisi-ile-ayni-gizli-deger"

# Environment
NODE_ENV="development"

# Alan agindaki (domain) bilgisayarlar sunucuya IP yerine MAKINE ADIYLA
# baglaniyorsa, bu ic ana bilgisayar adlarini virgulle ayirarak yazin.
# Buradaki adreslerden gelen girisler "yerel" sayilir: SMS ile giris
# dogrulama kodu ISTENMEZ (kod yalnizca dis/WAN IP ile baglananlardan
# istenir) ve "uzaktan/mobil erisim" yetki kisidina takilmazlar.
# 10.x / 192.168.x / 172.16-31.x / localhost / *.local zaten otomatik yereldir.
# DIS IP'yi veya herkese acik alan adini BURAYA YAZMAYIN.
#   Ornek: INTERNAL_HOSTS=sunucu,netsosyal.kurum.local,10.0.0.183
#   Ornek: INTERNAL_HOSTS=*.kurum.local
INTERNAL_HOSTS=""

# API Configuration
API_BASE_URL="http://localhost:3000"
GOOGLE_GEOCODING_API_KEY=""

# Pagination
DEFAULT_PAGE_SIZE=10

# Features (ileride eklenebilir)
ENABLE_EMAIL=false
ENABLE_SMS=false
ENABLE_REPORTS=true

# Logging
LOG_LEVEL="info"

# Web Push (masaüstü bildirimleri) - `npx web-push generate-vapid-keys` ile
# üretilir. PRIVATE anahtar asla client'a gönderilmemeli.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ornek@kurum.gov.tr"
