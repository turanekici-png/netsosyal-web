generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model InternalCommunication {
  id           BigInt                           @id @default(autoincrement())
  type         String                           @map("tur") @db.VarChar(20)
  senderUserId BigInt                           @map("gonderen_kullanici_id")
  subject      String?                          @map("baslik") @db.VarChar(200)
  content      String                           @map("icerik")
  priority     Int                              @default(0) @map("onem_seviyesi") @db.SmallInt
  parentId     BigInt?                          @map("ust_ileti_id")
  startsAt     DateTime?                        @map("yayin_baslangici") @db.Timestamp(6)
  expiresAt    DateTime?                        @map("yayin_bitisi") @db.Timestamp(6)
    status       String                           @default("aktif") @map("durum") @db.VarChar(20)
    senderArchivedAt DateTime?                    @map("gonderen_arsivlenme_tarihi") @db.Timestamp(6)
    createdAt    DateTime                         @default(now()) @map("olusturma_tarihi") @db.Timestamp(6)
  updatedAt    DateTime                         @updatedAt @map("guncelleme_tarihi") @db.Timestamp(6)
  recipients   InternalCommunicationRecipient[]
  attachments  InternalCommunicationAttachment[]

  @@index([senderUserId, createdAt], map: "idx_kurum_ici_iletisim_gonderen")
  @@index([type, status, createdAt], map: "idx_kurum_ici_iletisim_tur_durum")
  @@map("kurum_ici_iletisim")
}

model InternalCommunicationAttachment {
  id              BigInt                @id @default(autoincrement())
  communicationId BigInt                @map("iletisim_id")
  fileName        String                @map("dosya_adi") @db.VarChar(255)
  mimeType        String                @map("mime_turu") @db.VarChar(100)
  fileSize        Int                   @map("dosya_boyutu")
  content         Bytes                 @map("icerik")
  createdAt       DateTime              @default(now()) @map("olusturma_tarihi") @db.Timestamp(6)
  communication   InternalCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId], map: "idx_kurum_ici_iletisim_ekleri_iletisim")
  @@map("kurum_ici_iletisim_ekleri")
}

model InternalCommunicationRecipient {
  id              BigInt                @id @default(autoincrement())
  communicationId BigInt                @map("iletisim_id")
  recipientUserId BigInt                @map("alici_kullanici_id")
  readAt          DateTime?             @map("okunma_tarihi") @db.Timestamp(6)
  archivedAt      DateTime?             @map("arsivlenme_tarihi") @db.Timestamp(6)
  createdAt       DateTime              @default(now()) @map("olusturma_tarihi") @db.Timestamp(6)
  communication   InternalCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@unique([communicationId, recipientUserId], map: "uq_kurum_ici_iletisim_alici")
  @@index([recipientUserId, readAt, createdAt], map: "idx_kurum_ici_iletisim_alici_okunma")
  @@map("kurum_ici_iletisim_alicilari")
}

model Beneficiary {
  id              BigInt    @id @default(autoincrement())
  kullaniciid     Int?
  ilkkullaniciid  Int?
  updatedAt       DateTime? @map("islemtarihi") @db.Timestamp(6)
  createdAt       DateTime? @map("ilkislemtarihi") @db.Timestamp(6)
  dosyaId         BigInt?   @map("dosyaid")
  relation        Int?      @map("yakinligi")
  nationality     String?   @map("uyrugu") @db.VarChar(20)
  tc              String?   @unique(map: "ind_bireyler_tckimlikno") @map("tckimlikno") @db.VarChar(11)
  firstName       String?   @map("adi") @db.VarChar(30)
  lastName        String?   @map("soyadi") @db.VarChar(40)
  fatherName      String?   @map("babaadi") @db.VarChar(30)
  motherName      String?   @map("anaadi") @db.VarChar(30)
  birthPlace      String?   @map("dogumyeri") @db.VarChar(50)
  birthDate       DateTime? @map("dogumtarihi") @db.Date
  maritalStatus   Int?      @map("medenihali") @db.SmallInt
  gender          String?   @map("cinsiyeti") @db.Char(1)
  nfili           String?   @db.VarChar(30)
  district        String?   @map("nfilce") @db.VarChar(50)
  neighborhood    String?   @map("nfmahkoy") @db.VarChar(50)
  meslegi         String?   @db.VarChar(50)
  ogrenimdurumu   Int?
  mezunolokul     String?   @db.VarChar(100)
  healthStatus    Int?      @map("saglikdurumu")
  hastalikadi     String?   @db.VarChar(50)
  sosyalguvencesi Int?
  phone           String?   @map("ceptel") @db.VarChar(20)
  aylikgeliri     Int?
  notes           String?   @map("aciklama")
  name            String?   @map("adisoyadi") @db.VarChar(100)
  iban            String?   @db.VarChar(50)
  deathDate       String?   @map("olumtarihi") @db.VarChar(10)
  address         String?   @map("adres") @db.VarChar(200)
  status          Int?      @default(0) @map("tipi") @db.SmallInt
  tcsorgusyc      Int?
  addressNo       String?   @map("adresno")
  kontrol1        String?
  kontrol2        String?
  // Bu bireyin adresinin EN SON NVİ'den (nüfus) sorgulanıp güncellendiği
  // tarih - manuel "Nüfus Sorgula" butonundan VE dosya açıldığında otomatik
  // yapılan tazelik kontrolünden (bkz. lib/services/addressAutoRefresh.service.ts)
  // güncellenir. NULL ise hiç NVİ'den adres sorgulanmamış demektir (ilk
  // dosya açılışında otomatik sorgulanır).
  addressUpdatedAt DateTime? @map("adres_guncelleme_tarihi") @db.Timestamp(6)
  request         Request?  @relation(fields: [dosyaId], references: [id])

  @@index([tc], map: "idx_bireyler_tckimlikno")
  @@index([name], map: "ind_bireyler_adisoyadi")
  @@index([dosyaId], map: "ind_bireyler_dosyaid")
  @@index([iban], map: "ind_bireyler_iban")
  @@index([tcsorgusyc], map: "ind_bireyler_tcsorgusyc")
  @@index([status], map: "ind_bireyler_tipi")
  @@index([nationality], map: "ind_bireyler_uyrugu")
  @@index([relation], map: "ind_bireyler_yakinligi")
  @@map("bireyler")
}

model Request {
  id             BigInt         @id @default(autoincrement())
  kullaniciid    Int?
  ilkkullaniciid Int?
  updatedAt      DateTime?      @map("islemtarihi") @db.Timestamp(6)
  createdAt      DateTime?      @map("ilkislemtarihi") @db.Timestamp(6)
  title          String?        @map("dosyano") @db.VarChar(20)
  muracaattarihi DateTime?      @db.Date
  mahalleid      Int?
  mahalleadi     String?        @db.VarChar(30)
  cadde          String?        @db.VarChar(30)
  sokak          String?        @db.VarChar(30)
  site           String?        @db.VarChar(30)
  blok           String?        @db.VarChar(20)
  binano         String?        @db.VarChar(10)
  daireno        String?        @db.VarChar(5)
  address        String?        @map("adres") @db.VarChar(200)
  phone          String?        @map("telefon") @db.VarChar(30)
  aileniteligi   Int?
  konutturu      Int?
  isinmaturu     Int?
  mulkiyetdurumu Int?
  kiramiktari    Int?
  aciklama_old   String?        @map("aciklama-old")
  priority       Int?           @map("yaronceliksirasi")
  status         Int?           @map("durumu") @db.SmallInt
  durumutarih    DateTime?      @db.Date
  durumuaciklama String?        @db.VarChar(100)
  ilkkayittarihi DateTime?      @db.Date
  vizetarihi     DateTime?      @db.Date
  kartno         String?        @db.VarChar
  adresno        String?        @db.VarChar
  topbirey       Int?
  description    String?        @map("aciklama")
  locationLat    Float?         @map("konum_enlem")
  locationLon    Float?         @map("konum_boylam")
  locationSource String?        @map("konum_kaynagi") @db.VarChar(40)
  locationStatus String?        @map("konum_durumu") @db.VarChar(40)
  locationScore  Float?         @map("konum_guven")
  locationHash   String?        @map("konum_adres_hash") @db.VarChar(80)
  locationError  String?        @map("konum_hata")
  locationAt     DateTime?      @map("konum_tarihi") @db.Timestamp(6)
  beneficiaries  Beneficiary[]
  assistances    Assistance[]
  reports        Report[]
  workflowSteps  WorkflowStep[]

  @@index([title], map: "idx_dosyalar_dosyano")
  @@index([aileniteligi], map: "ind_dosyalar_aileniteligi")
  @@index([title], map: "ind_dosyalar_dosyano")
  @@index([status], map: "ind_dosyalar_durumu")
  @@index([locationLat, locationLon], map: "ind_dosyalar_konum")
  @@index([locationStatus], map: "ind_dosyalar_konum_durumu")
  @@index([kartno], map: "ind_dosyalar_kartno")
  @@index([mahalleid], map: "ind_dosyalar_mahalleid")
  @@index([muracaattarihi], map: "ind_dosyalar_muracaattarihi")
  @@index([vizetarihi], map: "ind_dosyalar_vizetarihi")
  @@map("dosyalar")
}

model Document {
  id                    Int       @id @default(autoincrement())
  requestId             Int?      @map("dosyaid")
  dosyano               String?
  tc                    String?   @map("tckimlikno")
  name                  String?   @map("adisoyadi")
  title                 String    @map("evrak_adi")
  status                String?   @default("bekliyor") @map("durum")
  son_gecerlilik_tarihi DateTime? @db.Date
  requestedDate         DateTime? @map("istenme_tarihi") @db.Timestamp(6)
  notes                 String?   @map("notlar")
  isteyen_kullanici     String?
  completedDate         DateTime? @map("tamamlanma_tarihi") @db.Timestamp(6)
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("beklenen_evraklar")
}

model Assistance {
  id              BigInt    @id(map: "yrd_ayninaktiyardim_pkey") @default(autoincrement())
  kullaniciid     Int?
  ilkkullaniciid  Int?
  updatedAt       DateTime? @map("islemtarihi") @db.Timestamp(6)
  createdAt       DateTime? @map("ilkislemtarihi") @db.Timestamp(6)
  requestId       BigInt?   @map("dosyaid")
  applicant       String?   @map("muracaateden") @db.VarChar(100)
  muracaattarihi  DateTime? @db.Date
  notes           String?   @map("muracaatnotu")
  amount          Int?      @map("miktar")
  asamanotu       String?
  status          Int?      @map("durumu")
  durumutarih     DateTime? @db.Date
  durumuaciklama  String?   @db.VarChar(100)
  donem           String?   @db.VarChar(50)
  tc              String?   @map("tckimlikno") @db.VarChar(20)
  phone           String?   @map("ceptel") @db.VarChar(20)
  type            String?   @map("asama") @db.VarChar(50)
  muracaatozelkod String?   @db.VarChar(40)
  aylikgelir      Int?
  iban            String?   @db.VarChar(45)
  etiket          String?   @db.VarChar(100)
  dogumtarihi     DateTime? @db.Date
  tahkikatpers    String?   @db.VarChar(100)
  mulkiyetbilgisi String?   @db.VarChar(20)
  aracbilgisi     String?   @db.VarChar(30)
  asamaozelkod    String?   @db.VarChar(50)
  topbirey        String?
  medenihal       String?
  request         Request?  @relation(fields: [requestId], references: [id])

  @@index([requestId], map: "idx_yrd_ayninakti_dosyaid")
  @@index([donem], map: "ind_yrd_ayninakti_donem")
  @@index([requestId], map: "ind_yrd_ayninakti_dosyaid")
  @@index([status], map: "ind_yrd_ayninakti_durumu")
  @@index([durumutarih], map: "ind_yrd_ayninakti_durumutarih")
  @@index([etiket], map: "ind_yrd_ayninakti_etiket")
  @@index([iban], map: "ind_yrd_ayninakti_iban")
  @@index([applicant], map: "ind_yrd_ayninakti_muracaateden")
  @@index([muracaattarihi], map: "ind_yrd_ayninakti_muracaattarih")
  @@index([tc], map: "ind_yrd_ayninakti_tckimlikno")
  @@index([requestId], map: "ind_yrd_ayninaktiyardim_dosyaid")
  @@index([status], map: "ind_yrd_ayninaktiyardim_durumu")
  @@map("yrd_ayninakti")
}

