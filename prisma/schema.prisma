model Setting {
  key       String   @id
  value     Json
  type      String   @default("json")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model Report {
  id             BigInt    @id @default(autoincrement())
  kullaniciid    Int?
  ilkkullaniciid Int?
  updatedAt      DateTime? @map("islemtarihi") @db.Timestamp(6)
  createdAt      DateTime? @map("ilkislemtarihi") @db.Timestamp(6)
  requestId      BigInt?   @map("dosyaid")
  date           DateTime? @map("tarih") @db.Date
  title          String?   @map("konu") @db.VarChar(200)
  content        String?   @map("rapor")
  // "Onaya Gönder" akisindan otomatik olusturulan raporlarda, talep
  // ONAYLANDIGINDA onaylayan kullaniciyi tutar (bkz. app/api/documents/
  // approval-requests/[id]/route.ts). Diger (elle girilen) raporlarda NULL.
  onaylayan_kullaniciid Int?
  request        Request?  @relation(fields: [requestId], references: [id])

  @@index([requestId], map: "ind_tahkikatraporlari_dosyaid")
  @@index([title], map: "ind_tahkikatraporlari_konu")
  @@index([date], map: "ind_tahkikatraporlari_tarih")
  @@map("tahkikatraporlari")
}

model WorkflowStep {
  id               BigInt    @id @default(autoincrement())
  title            String    @map("baslik")
  description      String?   @map("aciklama")
  requestId        BigInt?   @map("dosyaid")
  assignedStaff    String?   @map("atanacak_personel")
  status           String?   @default("BEKLIYOR") @map("durum")
  priority         String?   @default("NORMAL") @map("oncelik")
  dueDate          DateTime? @map("son_tarih") @db.Date
  olusturma_tarihi DateTime? @default(now()) @db.Timestamp(6)
  sorumlu          String?
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)
  completedDate    DateTime? @map("tamamlanma_tarihi") @db.Timestamp(6)
  dosyano          String?
  request          Request?  @relation(fields: [requestId], references: [id])

  @@map("sistem_gorevler")
}

model app_kullanici_yetkileri {
  id               Int       @id @default(autoincrement())
  /// Veritabanındaki kolon integer, bağlı kullanicilar.id kolonu ise bigint.
  /// Prisma farklı skaler tipler arasında relation üretemediği için ilişki alanı tanımlanmamıştır.
  kullanici_id     Int
  yetki_adi        String    @db.VarChar(100)
  aktif            Boolean?  @default(true)
  olusturma_tarihi DateTime? @default(now()) @db.Timestamp(6)
}

