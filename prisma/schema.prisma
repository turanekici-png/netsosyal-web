// Cenaze yemekleri - Ana Sayfa'daki "Cenaze Yemekleri" panelinde aylik
// verilen yemek sayisi ve odenen tutarin girildigi/raporlandigi tablo.
// Bir (yil, ay) icin TEK bir ozet satir tutulur (UNIQUE kisiti) - ayni ay
// icin tekrar veri girilirse GUNCELLENIR (upsert), coklu satir birikmez.
model CenazeYemekleri {
  id               BigInt   @id @default(autoincrement())
  yil              Int      @db.SmallInt
  ay               Int      @db.SmallInt
  yemekMiktari     Int      @default(0) @map("yemek_miktari")
  tutar            Decimal  @default(0) @db.Decimal(18, 2)
  aciklama         String?
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamp(6)
  guncellemeTarihi DateTime @default(now()) @updatedAt @map("guncelleme_tarihi") @db.Timestamp(6)

  @@unique([yil, ay], map: "uq_cenaze_yemekleri_yil_ay")
  @@index([yil], map: "idx_cenaze_yemekleri_yil")
  @@map("cenaze_yemekleri")
}

// Yardim Sayac - kullanicilarin BARKOD YAZICISINA gonderdikleri (basiliya
// verdikleri) yardimlarin kaydi. Sadece dort tur izlenir: Gida Bankasi,
// Donem Disi Gida, Destek Paketi, Giyim. Her basari ile yazdirma bir satir
// ekler (tekillestirme YOK - ayni dosya ayni gun tekrar yazdirilirsa yeni
// satir). Aktif ay verisine/akisina dokunmaz; yalniz bu tabloya yazar.
// Kayit eden yer: printRenderedDesign (app/(modules)/documents/page.tsx) ->
// POST /api/documents/yardim-sayac. Rapor: /reports/yardim-sayac.
model YardimSayac {
  id                BigInt   @id @default(autoincrement())
  islemTarihi       DateTime @default(now()) @map("islem_tarihi") @db.Timestamp(6)
  yardimTuru        String   @map("yardim_turu") @db.VarChar(60)
  dosyaNo           String?  @map("dosya_no") @db.VarChar(60)
  dosyaId           String?  @map("dosya_id") @db.VarChar(40)
  adSoyad           String?  @map("ad_soyad") @db.VarChar(200)
  miktar            String?  @db.VarChar(80)
  yaziciAdi         String?  @map("yazici_adi") @db.VarChar(200)
  gonderenKullanici String   @map("gonderen_kullanici") @db.VarChar(200)
  olusturmaTarihi   DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamp(6)
  // Kullanici istegi (Ekim 2026): giyim yardimi gonderirken o yardim icin
  // girilmis aciklama da kaydedilsin.
  aciklama          String?  @db.VarChar(500)

  @@index([islemTarihi(sort: Desc)], map: "idx_yardim_sayac_islem_tarihi")
  @@index([yardimTuru], map: "idx_yardim_sayac_yardim_turu")
  @@index([gonderenKullanici], map: "idx_yardim_sayac_gonderen")
  @@map("yardim_sayac")
}
