// Yardim/muracaat yazdirma onay talepleri - "Ayarlar > Yetkili Personeller"
// listesindeki bir kullanicinin, odeme penceresi disindaki (veya donem disi
// gida gibi pencere kavrami olmayan) kayitlar icin verdigi yazdirma onaylari.
// Bkz. app/api/documents/approval-requests, lib/services/approvalRequest.service.ts.
model yardim_onay_talepleri {
  id                    BigInt    @id @default(autoincrement())
  kayit_turu            String    @db.VarChar(40)
  kayit_id              BigInt
  dosya_id              BigInt
  donem                 Int?
  durum                 Int       @default(0) @db.SmallInt
  talep_eden_kullaniciid Int?
  talep_tarihi          DateTime  @default(now()) @db.Timestamp(6)
  onaylayan_kullaniciid Int?
  onay_tarihi           DateTime? @db.Timestamp(6)
  aciklama              String?   @db.VarChar(300)
  red_aciklama          String?   @db.VarChar(300)
  // "Onaya Gönder" penceresinde secilen Yetkili Personel (bilgi/yonlendirme
  // amacli - kuyruk yine TUM yetkili personele acik kalir, sadece bu kisiye
  // ozel bir bildirim gonderilir).
  hedef_kullaniciid     Int?
  // Karar verildikten (durum 1/2) sonra, talep eden kullaniciya gosterilen
  // bildirim GORULDU MU (bkz. app/api/notifications/approval-decisions).
  bildirim_gorundu      Boolean   @default(false)
  // Talep hedef_kullaniciid'e yonlendirilmisse, o kisiye "onay bekleyen
  // isleminiz var" seklinde gosterilen bildirim GORULDU MU (bkz.
  // app/api/notifications/approval-assigned).
  hedef_bildirim_gorundu Boolean  @default(false)
  // Talep olusturulurken ACIKLAMA metniyle otomatik olarak "İnceleme
  // Raporları"na (tahkikatraporlari) eklenen raporun id'si - talep
  // onaylandiginda o raporda onaylayan bilgisini de gosterebilmek icin.
  rapor_id              BigInt?

  @@index([kayit_turu, kayit_id, donem], map: "ind_yardim_onay_lookup")
  @@index([durum], map: "ind_yardim_onay_durum")
}

// Onay taleplerinin (yardim_onay_talepleri) her ASAMASINI (talep edildi,
// onaylandi, reddedildi, iptal edildi) kalici, DEGISTIRILEMEZ bir gunluk
// olarak kaydeder - yardim_onay_talepleri sadece GUNCEL durumu tutar
// (mutable), bu tablo ise TAM GECMISI (immutable audit trail) tutar. Bkz.
// app/api/documents/approval-requests - her POST/PATCH burada bir satir ekler.
model onay_islemleri {
  id            BigInt   @id @default(autoincrement())
  onay_talep_id BigInt
  islem_tipi    String   @db.VarChar(20)
  kayit_turu    String   @db.VarChar(40)
  kayit_id      BigInt
  dosya_id      BigInt
  donem         Int?
  kullaniciid   Int?
  aciklama      String?  @db.VarChar(300)
  islem_tarihi  DateTime @default(now()) @db.Timestamp(6)

  @@index([onay_talep_id], map: "ind_onay_islemleri_talep")
  @@index([kayit_turu, kayit_id], map: "ind_onay_islemleri_kayit")
  @@index([dosya_id], map: "ind_onay_islemleri_dosya")
  @@index([islem_tipi], map: "ind_onay_islemleri_tipi")
  @@index([islem_tarihi], map: "ind_onay_islemleri_tarih")
}

