// ESKI (artik yeni kayit YAZILMAYAN) WhatsApp gonderim log tablosu - bkz.
// asagidaki sms_gonderim_log notu: WhatsApp loglari artik dogrudan
// sms_gonderim_log'a (kanal='whatsapp') yaziliyor, tum mesajlar TEK tabloda
// birikiyor. Bu model ve tablo, gecmis (bu degisiklikten ONCEKI) kayitlarin
// kaybolmamasi icin SILINMEDEN duruyor.
model whatsapp_gonderim_log {
  id            Int       @id @default(autoincrement())
  telefon       String?
  adisoyadi     String?
  dosyano       String?
  dosyaid       String?
  mesaj         String?
  durum         String?
  cevap         String?
  gonderim_tipi String?
  kullanici     String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at], map: "ind_whatsapp_gonderim_log_created_at")
}

// Gonderilen TUM mesajlarin (hem harici SMS entegrasyonu HEM DE bu uygulama
// uzerinden gonderilen WhatsApp mesajlarinin) TEK ORTAK kaydi. "kanal" sutunu
// ('sms' | 'whatsapp') kaynagi ayirt eder - harici SMS sistemi bu sutunu
// bilmez, o yuzden varsayilani 'sms'dir (bkz. migration
// 20260816090000_add_sms_gonderim_log_kanal). "sms_tipi" alani SMS icin
// harici sistemin kendi degerlerini ('tek' vb.) tasirken, WhatsApp
// kayitlarinda ayni alan gonderim turunu ('tekil'/'toplu'/'otomatik-bildirim')
// tasir - bkz. lib/services/whatsappLog.service.ts. Raporlar > SMS/WhatsApp
// Raporlari ekrani VE Dosya Yonetimi > Mesaj Raporlari (bkz.
// app/api/documents/message-log/route.ts) buradan okur. "wa_message_id"
// SADECE WhatsApp kayitlarinda dolu olur (whatsapp-web.js mesaj kimligi) -
// gonderim sonrasi gelen 'message_ack' olaylarinin (iletildi/okundu) hangi
// satiri guncelleyecegini bulmak icin kullanilir (bkz.
// lib/services/whatsappWeb.service.ts, recordWhatsappMessageAck). WhatsApp
// icin "durum" degerleri zamanla ilerler: gönderildi -> iletildi -> okundu
// (veya hata).
model sms_gonderim_log {
  id         Int       @id @default(autoincrement())
  telefon    String?
  adisoyadi  String?
  dosyano    String?
  tckimlikno String?
  mesaj      String?
  durum      String?
  cevap      String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  sms_tipi   String?
  sablon     String?
  kullanici  String?
  dosyaid    String?
  kanal      String    @default("sms")
  wa_message_id String?

  @@index([kanal], map: "ind_sms_gonderim_log_kanal")
  @@index([wa_message_id], map: "ind_sms_gonderim_log_wa_message_id")
}

